@startuml form
interface Expression
class Polynomial
Polynomial .up.|> Expression
Polynomial --> "2..*" Term : terms
class Term {
    int coefficient
}
Term -up-|> Polynomial
Term --> "2..*" Factor : factors
class Factor {
    boolean multiply
    int power
}
Factor -up-|> Term
Factor --> "1" Primary : primary
abstract class Primary
Primary -up-|> Factor
class Variable {
    String name
}
Variable -up-|> Primary
class Paren
Paren -up-|> Primary
Paren -up-> "1" Polynomial : polynomial
@enduml