@startuml form
enum FactorOperator {
    MULTIPLY
    DIVIDE
}
interface Polynomial
Polynomial --|> Primary
class Terms {
}
Terms .up.|> Polynomial
class Term {
    int coefficient
}
Terms --> "*" Term : terms
class Factor {
    FactorOperator operator
    int power
}
Factor --> Primary : primary
Term --> "*" Factor : factors
interface Primary
class Variable {
    String name
}
Variable .up.|> Primary
@enduml