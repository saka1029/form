@startuml form
interface Expression {
    Expression expand()
}
enum Op {
    PLUS
    MINUS
    MULTIPLY
    DIVIDE
}
class ExprBinary {
    Op oprator
}
interface Primary
class Polynomial
class Term {
    int coefficient
}
class Factor {
    int power
}
class Variable {
    String name
}
ExprBinary .up.|> Expression
Primary -up-|> Expression
Polynomial .up.|> Primary
Polynomial -right-> "*" Term
Term -right-> "*" Factor
Variable .up.|> Primary
ExprBinary --> Expression : left
ExprBinary --> Expression : right
Factor -->  "*"Primary
@enduml