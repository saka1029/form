@startuml form
interface Polynomial
class PolynomialImpl
PolynomialImpl .left.|> Polynomial
PolynomialImpl --> "*" Term : terms
interface Term
Term -|> Polynomial
class TermImpl {
    Rational coefficient
}
TermImpl .left.|> Term
TermImpl --> "*" Factor : factors
interface Factor
Factor -|> Term
class FactorImpl
FactorImpl .left.|> Factor
FactorImpl --> "*" Power : numerators
FactorImpl --> "*" Power : denominators
interface Power
Power -|> Factor
class PowerImpl {
    long power
}
PowerImpl .left.|> Power
PowerImpl --> "1" Primary : primary
interface Primary
Primary -|> Power
class Variable {
    String name
}
Variable .up.|> Primary
class Number {
    int value
}
Number .up.|> Primary
class Paren
Paren .up.|> Primary
Paren -up-> Polynomial : polynomial
@enduml