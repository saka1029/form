@startuml form
interface Expression
class ExprBinary
class ExprNegate
class ExprPlus
class ExprMinus
class ExprMult
class ExprDivide
interface Primary
class Polynomial
class Term {
    int coefficient
}
class Factor {
    int power
}
class Variable {
    String name
}
ExprBinary .up.|> Expression
ExprPlus -up-|> ExprBinary
ExprMinus -up-|> ExprBinary
ExprMult -up-|> ExprBinary
ExprDivide -up-|> ExprBinary
Primary -up-|> Expression
Polynomial .up.|> Primary
Variable .up.|> Primary
ExprNegate --> Expression : expr
ExprBinary --> Expression : left
ExprBinary --> Expression : right
Polynomial --> "*" Term
Term --> "*" Factor
Factor -->  "*"Primary
@enduml