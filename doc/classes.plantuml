@startuml form
interface Polynomial
class PolynomialImpl
PolynomialImpl .left.|> Polynomial
PolynomialImpl --> "*" Term : terms
interface Term
Term -|> Polynomial
class TermImpl
TermImpl .left.|> Term
TermImpl --> "1" Factor : numerator
TermImpl --> "1" Factor : denominator
interface Factor
Factor -|> Term
class FactorImpl {
    int coefficient
}
FactorImpl .left.|> Factor
FactorImpl --> "*" Power : powers
interface Power
Power -|> Factor
class PowerImpl {
    int power
}
PowerImpl .left.|> Power
PowerImpl --> "1" Primary : primary
interface Primary
Primary -|> Power
class Variable {
    String name
}
Variable .up.|> Primary
class Number {
    int value
}
Number .up.|> Primary
class Paren
Paren .up.|> Primary
Paren -up-> Polynomial : polynomial
@enduml