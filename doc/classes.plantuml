@startuml form
interface Expression
enum Op {
    PLUS
    MINUS
    MULT
    DIVIDE
}
class ExprBinary {
    Op oprator
}
interface Primary
class Polynomial
class Term {
    int coefficient
}
class Factor {
    int power
}
class Variable {
    String name
}
ExprBinary .up.|> Expression
Primary -up-|> Expression
Polynomial .up.|> Primary
Variable .up.|> Primary
ExprBinary --> Expression : left
ExprBinary --> Expression : right
Polynomial --> "*" Term
Term --> "*" Factor
Factor -->  "*"Primary
@enduml