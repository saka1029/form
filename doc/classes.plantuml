@startuml form
enum FactorOperator {
    MULTIPLY
    DIVIDE
}
interface Polynomial
class PolynomialImpl
PolynomialImpl .left.|> Polynomial
PolynomialImpl --> "*" Term : terms
interface Term
Term -|> Polynomial
class TermImpl {
    int coefficient
}
TermImpl .left.|> Term
TermImpl --> "*" Factor : factors
interface Factor
Factor --|> Term
class FactorImpl {
    FactorOperator operator
    int power
}
FactorImpl .left.|> Factor
FactorImpl --> Primary : primary
interface Primary
Primary --|> Factor
class Variable {
    String name
}
Variable .up.|> Primary
class Paren
Paren .up.|> Primary
Paren -up-> Polynomial : polynomial
@enduml