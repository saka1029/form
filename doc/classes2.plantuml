@startuml form
enum FactorOperator {
    MULTIPLY
    DIVIDE
}
interface Polynomial {
    Set<Term> terms()
}
Polynomial --|> Primary
class PolynomialImpl
PolynomialImpl .left.|> Polynomial
PolynomialImpl --> "*" Term : terms
interface Term {
    int coefficient()
    Set<Factor> factors()
}
class TermImpl {
    int coefficient
    Set<Factor> factors
}
TermImpl .left.|> Term
interface Factor {
    FactorOperator operator()
    int power()
    Primary primary()
}
Factor --> Primary : primary
class FactorImpl {
    FactorOperator operator
    int power
    Primary primary
}
FactorImpl .left.|> Factor
Term --> "*" Factor : factors
interface Primary
class Variable {
    String name
}
Variable .up.|> Primary
@enduml