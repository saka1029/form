@startuml form
interface Expression
interface Polynomial
Polynomial -up-|> Expression
class Terms
Terms .up.|> Polynomial
class Term {
    int coefficient
}
'Term .up.|> Polynomial
Terms -right-> "*" Term : terms
class Factor {
    int power
}
'Factor .up.|> Polynomial
Factor -up-> Expression
Term -right-> "*" Factor : factors
class Variable {
    String name
}
Variable .up.|> Expression
'Variable .up.|> Polynomial
'enum Op {
'    PLUS
'    MINUS
'    MULTIPLY
'    DIVIDE
'}
@enduml