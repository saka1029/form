@startuml form
enum FactorOperator {
    MULTIPLY
    DIVIDE
}
interface Polynomial
class PolynomialImpl
PolynomialImpl .left.|> Polynomial
PolynomialImpl --> "*" Term : terms
interface Term
Term -up-|> Polynomial
Term --> "*" Factor : factors
class TermImpl {
    int coefficient
    Set<Factor> factors
}
TermImpl .left.|> Term
interface Factor
Factor -up-|> Term
Factor --> Primary : primary
class FactorImpl {
    FactorOperator operator
    int power
    Primary primary
}
FactorImpl .left.|> Factor
interface Primary
Primary -up-|> Factor
class Variable {
    String name
}
Variable .up.|> Primary
class Paren
Paren .up.|> Primary
Paren -up-> Polynomial : polynomial
@enduml